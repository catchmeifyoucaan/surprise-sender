{
  "name": "surprise-sender-server",
  "version": "1.0.0",
  "description": "Enterprise-grade email automation platform backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "postbuild": "npm ci --prefix .. --no-audit --no-fund && npm run build --prefix ..",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.4",
    "typeorm": "^0.3.17",
    "sqlite3": "^5.1.6",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "uuid": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "csv-parse": "^5.4.0",
    "zod": "^3.22.4",
    "speakeasy": "^2.0.0",
    "@google/generative-ai": "^0.2.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/nodemailer": "^6.4.9",
    "@types/uuid": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/csv-parse": "^1.2.2",
    "@types/speakeasy": "^2.0.7",
    "@types/compression": "^1.7.2",
    "@types/node": "^20.5.0",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "email",
    "automation",
    "smtp",
    "ai",
    "enterprise",
    "typescript",
    "express",
    "typeorm"
  ],
  "author": "Surprise Sender Team",
  "license": "MIT"
}
