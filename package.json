{
  "name": "surprise-sender",
  "version": "1.0.0",
  "description": "Enterprise-grade email automation platform with advanced AI capabilities",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:start": "cd server && npm start",
    "start:prod": "cd server && npm run start:prod",
    "build:all": "npm run build && npm run server:build",
    "install:all": "npm install && cd server && npm install",
    "migration:run": "cd server && npm run migration:run",
    "migration:generate": "cd server && npm run migration:generate",
    "seed": "cd server && npm run seed",
    "test": "jest",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix"
  },
  "dependencies": {
    "@google/genai": "^1.15.0",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "@tinymce/tinymce-react": "^6.3.0",
    "axios": "^1.11.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^9.9.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.15.0",
    "tailwind-merge": "^1.14.0",
    "terser": "^5.43.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "email",
    "automation",
    "smtp",
    "ai",
    "enterprise",
    "react",
    "typescript",
    "vite"
  ],
  "author": "Surprise Sender Team",
  "license": "MIT"
}
